{
    "name": "AegisBank-Auth-Core Dev Environment",
    "dockerComposeFile": ["../compose.yaml"],
    "service": "laravel.test",
    // 💡 Codespacesが自動生成する標準ワークスペースフォルダをそのまま正解として使用します
    "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
    "features": {
        "ghcr.io/devcontainers/features/github-cli:1": {}
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "amiralia.laraphense",
                "onecentlin.laravel-blade",
                "onecentlin.laravel5-snippets",
                "calebporzio.better-phpunit",
                "junstyle.php-cs-fixer"
            ]
        }
    },
    "remoteUser": "sail",
    // 💡 コンテナ起動後に、必要な環境設定、パッケージ導入、ハッシュ化デモDB注入までを一撃で全自動実行します
    "postCreateCommand": "cp .env.example .env && composer install && npm install && npm run build && php artisan key:generate && php artisan migrate --seed"
}
