{
    "name": "AegisBank-Auth-Core Dev Environment",
    "dockerComposeFile": ["../compose.yaml"],
    "service": "laravel.test",
    "workspaceFolder": "/var/www/html",
    "features": {
        "ghcr.io/devcontainers/features/github-cli:1": {}
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "amiralia.laraphense",
                "onecentlin.laravel-blade",
                "onecentlin.laravel5-snippets",
                "calebporzio.better-phpunit",
                "junstyle.php-cs-fixer"
            ]
        }
    },

    "remoteUser": "sail",
    // 💡 以下の2行を新しく追加して、ソースコードの場所をCodespacesに100.0%正確に伝えます
    "workspaceMount": "source=${localWorkspaceFolder},target=/var/www/html,type=bind,consistency=cached",
    "workspaceFolder": "/var/www/html",

    "postCreateCommand": "cp .env.example .env && composer install && npm install && npm run build && php artisan key:generate && php artisan migrate --seed"
}
