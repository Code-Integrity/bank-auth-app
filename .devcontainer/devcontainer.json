{
    "name": "AegisBank-Auth-Core Dev Environment",
    "dockerComposeFile": ["../compose.yaml"],

    "service": "laravel.test",
    "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
    "features": {
        "ghcr.io/devcontainers/features/github-cli:1": {}
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "amiralia.laraphense",
                "onecentlin.laravel-blade",
                "onecentlin.laravel5-snippets",
                "calebporzio.better-phpunit",
                "junstyle.php-cs-fixer"
            ]
        }
    },

    "remoteUser": "vscode",

    "postCreateCommand": "cp .env.example .env && composer install && npm install && npm run build && php artisan key:generate && php artisan migrate --seed && php artisan serve --host=0.0.0.0 --port=8080"
}
